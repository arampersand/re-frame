# Copia a .env (raíz del repo). NUNCA subas .env a git.
# La app arranca y hace la demo SIN ninguna llave (modo default alive).

# --- LLM: con UNA basta. Failover Anthropic → Groq → Gemini → OpenAI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Transcripción de clases: OPENAI_API_KEY (Whisper) o GROQ_API_KEY (Whisper turbo, gratis) ---
STT_LANGUAGE=          # vacío = autodetecta español/inglés

# --- Google Calendar (solo quien hace la demo). Ver backend/scripts/google_auth.py ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
TIMEZONE=America/Denver
DRY_RUN=true           # true = nunca escribe en Google; deja recibo "skipped"

# --- Desktop ---
VITE_API_URL=http://127.0.0.1:8787
